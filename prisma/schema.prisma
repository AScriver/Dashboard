generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model HelperAgentSettings {
  id                         String   @id
  codexResearchPrompt        String?
  codexImplementationPrompt  String?
  agentClaimLeaseMinutes Int @default(30)
  agentClaimExpiryWarningMinutes Int @default(10)
  localCodexTimeoutSeconds   Int?
  inboxTriagerBatchSize      Int      @default(5)
  inboxTriagerEnabled        Boolean  @default(true)
  inboxTriagerModel          String?
  inboxTriagerReasoningEffort String?
  inboxTriagerPrompt         String
  noteGroomerEnabled         Boolean  @default(true)
  noteGroomerModel           String?
  noteGroomerReasoningEffort String?
  noteGroomerPrompt          String
  relationshipAuditorEnabled Boolean  @default(true)
  relationshipAuditorModel String?
  relationshipAuditorReasoningEffort String?
  relationshipAuditorPrompt  String
  version                    Int      @default(1)
  updatedAt                  DateTime @updatedAt
}

model Project {
  id           String       @id @default(cuid())
  externalKey  String       @unique
  name         String
  importBaselineJson Json?
  version      Int          @default(1)
  archivedAt   DateTime?
  repositories Repository[]
  worktrees    Worktree[]
  actionables  Actionable[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Repository {
  id          String       @id @default(cuid())
  externalKey String       @unique
  name        String
  importBaselineJson Json?
  version     Int          @default(1)
  archivedAt  DateTime?
  localPath   String?
  projectRoot String?
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worktrees   Worktree[]
  actionables Actionable[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Worktree {
  id           String       @id @default(cuid())
  externalKey  String       @unique
  name         String
  importBaselineJson Json?
  version      Int          @default(1)
  archivedAt   DateTime?
  localPath    String?
  projectId    String
  repositoryId String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  actionables  Actionable[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Actionable {
  id                     String     @id @default(cuid())
  externalKey            String     @unique
  sourceOrdinal          Int        @unique
  title                  String
  priority               String
  status                 String     @default("Inbox")
  statusProvenance       String
  sourceStatusSuggestion String?
  effort                 String
  evidenceState          String     @default("Unclassified")
  version                Int        @default(1)
  archivedAt             DateTime?
  updatedLabel           String
  manualBlockerMd        String?
  dismissalReasonMd      String?
  completionOverrideMd   String?
  finding                String
  description            String
  resolution             String     @default("")
  researchJson           Json
  validationJson         Json
  filesJson              Json
  tagsJson               Json
  userSourcesJson        Json       @default("[]")
  blockedByOrdinalsJson  Json
  blocksOrdinalsJson     Json
  parentOrdinal          Int?
  childOrdinalsJson      Json
  importProvider         String
  sourceContainerId      String
  sourceThread           String
  contentHash            String
  rawFragmentJson        Json
  importBaselineJson     Json?
  fieldOwnershipJson     Json?
  projectId              String
  repositoryId           String
  worktreeId             String
  project                Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository             Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  worktree               Worktree   @relation(fields: [worktreeId], references: [id], onDelete: Cascade)
  statusHistory          ActionableStatusHistory[]
  validationRecords      ValidationRecord[]
  activityEvents         ActivityEvent[]
  userSources            UserSourceReference[]
  hierarchyAsParent      HierarchyRelationship[]  @relation("HierarchyParent")
  hierarchyAsChild       HierarchyRelationship[]  @relation("HierarchyChild")
  dependenciesAsDependent    DependencyRelationship[] @relation("DependencyDependent")
  dependenciesAsPrerequisite DependencyRelationship[] @relation("DependencyPrerequisite")
  agentTaskClaim         AgentTaskClaim?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([projectId, worktreeId, sourceOrdinal])
  @@index([priority, status])
  @@index([archivedAt, status, updatedAt])
  @@index([projectId, repositoryId, worktreeId, archivedAt])
}

model AgentTaskClaim {
  actionableId   String     @id
  agentId        String
  claimTokenHash String     @unique
  leaseExpiresAt DateTime
  claimedAt      DateTime   @default(now())
  renewedAt      DateTime   @updatedAt
  actionable     Actionable @relation(fields: [actionableId], references: [id], onDelete: Cascade)

  @@index([agentId, leaseExpiresAt])
}

model ImportRun {
  id             String   @id @default(cuid())
  documentDigest String
  format         String
  schemaVersion  Int
  sourceName     String?
  summaryJson    Json
  committedAt    DateTime @default(now())

  @@index([committedAt])
}

model ActionableStatusHistory {
  id             String     @id @default(cuid())
  actionableId   String
  previousStatus String?
  newStatus      String
  origin         String
  occurredAt     DateTime   @default(now())
  actionable     Actionable @relation(fields: [actionableId], references: [id], onDelete: Cascade)

  @@index([actionableId, occurredAt])
}

model ValidationRecord {
  id           String            @id @default(cuid())
  actionableId String
  type         String
  outcome      String
  notesMd      String
  evidenceMd   String
  origin       String
  recordedAt   DateTime          @default(now())
  supersedesId String?           @unique
  actionable   Actionable        @relation(fields: [actionableId], references: [id], onDelete: Cascade)
  supersedes   ValidationRecord? @relation("ValidationCorrections", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy ValidationRecord? @relation("ValidationCorrections")

  @@index([actionableId, recordedAt])
}

model ActivityEvent {
  id           String     @id @default(cuid())
  actionableId String
  type         String
  summary      String
  metadataJson Json
  occurredAt   DateTime   @default(now())
  actionable   Actionable @relation(fields: [actionableId], references: [id], onDelete: Cascade)

  @@index([actionableId, occurredAt])
}

model UserSourceReference {
  id           String     @id @default(cuid())
  actionableId String
  type         String
  locator      String
  label        String?
  provenance   String     @default("user-added")
  createdAt    DateTime   @default(now())
  removedAt    DateTime?
  actionable   Actionable @relation(fields: [actionableId], references: [id], onDelete: Cascade)

  @@index([actionableId, createdAt])
}

model HierarchyRelationship {
  id         String     @id @default(cuid())
  parentId   String
  childId    String
  createdAt  DateTime   @default(now())
  detachedAt DateTime?
  provenance String     @default("user")
  parent     Actionable @relation("HierarchyParent", fields: [parentId], references: [id], onDelete: Restrict)
  child      Actionable @relation("HierarchyChild", fields: [childId], references: [id], onDelete: Restrict)

  @@index([parentId, detachedAt])
  @@index([childId, detachedAt])
}

model DependencyRelationship {
  id             String     @id @default(cuid())
  dependentId    String
  prerequisiteId String
  waivedAt       DateTime?
  waiverReason   String?
  removedAt      DateTime?
  createdAt      DateTime   @default(now())
  provenance     String     @default("user")
  dependent      Actionable @relation("DependencyDependent", fields: [dependentId], references: [id], onDelete: Restrict)
  prerequisite   Actionable @relation("DependencyPrerequisite", fields: [prerequisiteId], references: [id], onDelete: Restrict)

  @@index([dependentId, removedAt])
  @@index([prerequisiteId, removedAt])
}
